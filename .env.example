# TrillionTape hosted libSQL. This game does not use Vercel.
# Create keys, then deploy the data host on Fly (or Docker on a box):
#
#   npm run data-host:auth
#   # follow the printed Fly / Docker steps
#
# Unset both to use a local file at data/bazaar.db (Cursor / npm run dev).
# Do not copy another project's database URL or token.

# TRILLIONTAPE_DATABASE_URL=https://trilliontape-data.fly.dev
# TRILLIONTAPE_AUTH_TOKEN=
