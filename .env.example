# TrillionTape hosted database (Turso / libSQL).
# Create a NEW database named trilliontape. Do not reuse another project's
# URL or token — those belong to other games.
#
#   turso db create trilliontape
#   turso db show trilliontape --url
#   turso db tokens create trilliontape
#
# Unset both to use a local file at data/bazaar.db (Cursor / npm run dev).

# TRILLIONTAPE_DATABASE_URL=libsql://trilliontape-YOURORG.turso.io
# TRILLIONTAPE_AUTH_TOKEN=
